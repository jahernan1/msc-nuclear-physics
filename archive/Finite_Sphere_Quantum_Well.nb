Cell[BoxData[{
 RowBox[{
  RowBox[{"clear", "[", "z0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z0", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"besselD", "[", "l_", "]"}], "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"SphericalBesselJ", "[", 
      RowBox[{"l", ",", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"z0", "^", "2"}], "+", 
         RowBox[{"z", "^", "2"}]}], "]"}]}], "]"}], ",", "z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hankelD", "[", "l_", "]"}], "=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"SphericalHankelH1", "[", 
       RowBox[{"l", ",", "z"}], "]"}], ",", "z"}], "]"}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transleft", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z0", "/", "z"}], ")"}], "^", "2"}], "-", "1"}], ")"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"transright", "[", "l_", "]"}], "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"SphericalBesselJ", "[", 
       RowBox[{"l", ",", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"z0", "^", "2"}], "+", 
          RowBox[{"z", "^", "2"}]}], "]"}]}], "]"}], "/", 
      RowBox[{"besselD", "[", "l", "]"}]}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"hankelD", "[", "l", "]"}], "]"}], "/", 
      RowBox[{"Abs", "[", 
       RowBox[{"SphericalHankelH1", "[", 
        RowBox[{"l", ",", "z"}], "]"}], "]"}]}], ")"}]}]}], ";"}]}], "Input",
